generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

model User {
  id       String  @id @default(cuid())
  fullName String
  email    String  @unique
  phone    String  @unique
  password String
  role     Role    @default(PHARMACIST)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  medicines Medicine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medicine {
  id String @id @default(cuid())

  name        String
  genericName String?

  sellingPrice Decimal @db.Decimal(10, 2)

  stock        Int @default(0)
  minimumStock Int @default(10)

  unit String

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  batches MedicineBatch[]

  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  barcode   String?  @unique
}

model Supplier {
  id          String  @id @default(cuid())
  name        String
  email       String? @unique
  phone       String  @unique
  address     String?
  companyName String?
  isActive    Boolean @default(true)

  batches   MedicineBatch[]
  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purchase {
  id String @id @default(cuid())

  invoiceNo String @unique

  purchaseDate DateTime @default(now())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  totalAmount Decimal @db.Decimal(10, 2)

  items PurchaseItem[]

  batches MedicineBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseItem {
  id String @id @default(cuid())

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  batchId String
  batch   MedicineBatch @relation(fields: [batchId], references: [id])

  quantity Int

  purchasePrice Decimal @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
}

model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String? @unique
  email   String? @unique
  address String?

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loyaltyPoints Int @default(0)
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  MIXED
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
}

model Sale {
  id String @id @default(cuid())

  invoiceNo String @unique

  saleDate DateTime @default(now())

  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id])

  totalAmount Decimal @db.Decimal(10,2)

  discount Decimal @db.Decimal(10,2) @default(0)

  tax Decimal @db.Decimal(10,2) @default(0)

  paymentMethod PaymentMethod

  paymentStatus PaymentStatus @default(PAID)

  paidAmount Decimal @db.Decimal(10,2)

  balanceAmount Decimal @db.Decimal(10,2) @default(0)

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleItem {
  id String @id @default(cuid())

  saleId String
  sale Sale @relation(fields: [saleId], references: [id])

  batchId String
  batch MedicineBatch @relation(fields: [batchId], references: [id])

  quantity Int

  costPrice Decimal @db.Decimal(10,2)

  sellingPrice Decimal @db.Decimal(10,2)

  subtotal Decimal @db.Decimal(10,2)

  createdAt DateTime @default(now())
}

enum TransactionType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  EXPIRED
  DAMAGED
}

model InventoryTransaction {
  id String @id @default(cuid())

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  batchId String?
  batch   MedicineBatch? @relation(fields: [batchId], references: [id])

  type TransactionType

  quantity Int

  previousStock Int

  newStock Int

  referenceId String?

  notes String?

  createdAt DateTime @default(now())

  @@index([medicineId])
  @@index([batchId])
  @@index([type])
}

enum NotificationType {
  LOW_STOCK
  EXPIRED
  EXPIRING
  SYSTEM
}

model Notification {
  id String @id @default(cuid())

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  isArchived Boolean @default(false)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}

model MedicineBatch {
  id String @id @default(cuid())

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  batchNo String

  manufacturingDate DateTime?

  expiryDate DateTime

  purchasePrice Decimal @db.Decimal(10, 2)

  quantity Int
  remainingQuantity Int @default(0)
  rackLocation String?

  purchaseItems PurchaseItem[]

  saleItems SaleItem[]

  inventoryTransactions InventoryTransaction[]

  isActive Boolean @default(true)

  receivedDate DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([medicineId, batchNo])
  @@index([expiryDate])
  @@index([medicineId, expiryDate])
  @@index([medicineId, remainingQuantity])
}
